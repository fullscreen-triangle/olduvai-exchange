# Rust
/target/
**/*.rs.bk
*.pdb

# Node / Next.js
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# WASM build output
pkg/

# ⚠️ Secrets. Local env files are never committed — see the note in README.md.
.env
.env.*.local
**/.env*.local
*.pem
*.key

# ⚠️ Every one of the patterns above anchors `.local` at the END of the name, so a file
# called `.env.local.example` matched NONE of them. `web/.env.local.example` was found
# holding live Cesium, Mapbox, OpenWeatherMap, TomTom, HuggingFace, Gemini and OpenAI
# credentials — untracked, but one `git add .` from the public remote. A name that reads
# like a template is not a guarantee that it holds placeholders.
#
# ⭐ So match `.env` anywhere in the name, with any suffix. The `!.env.example` exception
# keeps the one file that is *meant* to be committed — see the KEY NAMES ONLY rule there.
**/.env*
!**/.env.example

# purpose index (local cache)
.purpose/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# SSH private keys. ⚠️ *.pem and *.key above match neither an OpenSSH key
# nor id_ed25519-style names. See notes/36-server-deployment.md §2.1.
id_*
*_deploy
*_rsa
*_ed25519
!*.pub
