# ⚠️ KEY NAMES ONLY. This file is committed. Never put a value in it.
#
# Copy to `.env.local` (gitignored) and fill in there. A file whose name merely *reads*
# like a template is not protected by anything — `web/.env.local.example` was found holding
# seven live credentials, matching no gitignore pattern, one `git add .` from a public
# remote. `.gitignore` now ignores `**/.env*` and excepts only this file.

# --- Map rendering -------------------------------------------------------------------
# ⚠️ NEXT_PUBLIC_ is inlined into the client bundle at build time and is readable by anyone
# who loads the page. Only ever put a token here that is *designed* to be public and is
# scoped by URL referrer at the provider. A secret with this prefix is a published secret.
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=

# --- Engine and model ----------------------------------------------------------------
# The Rust engine. Loopback by default; see crates/olduvai-server.
OLDUVAI_SERVER_URL=

# The local model the assistant pipeline calls. See web/src/lib/ai/ollama.js.
OLLAMA_URL=
OLLAMA_MODEL=

# --- Access --------------------------------------------------------------------------
# ⚠️ Not a password and not authentication. It gates who can open a session on a
# deployment; it identifies nobody. Unset means no gate, which is correct for a local run.
# See web/src/pages/api/session.js.
OLDUVAI_INVITE=
